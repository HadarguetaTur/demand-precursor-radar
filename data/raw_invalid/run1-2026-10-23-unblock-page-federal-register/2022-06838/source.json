{"abstract":"This notice contains a summary of a petition seeking relief from specified requirements of Federal Aviation Regulations. The purpose of this notice is to improve the public's awareness of, and participation in, the FAA's exemption process. Neither publication of this notice nor the inclusion nor omission of information in the summary is intended to affect the legal status of the petition or its final disposition.","action":"Notice.","agencies":[{"id":492,"json_url":"https://www.federalregister.gov/api/v1/agencies/492","name":"Transportation Department","parent_id":null,"raw_name":"DEPARTMENT OF TRANSPORTATION","slug":"transportation-department","url":"https://www.federalregister.gov/agencies/transportation-department"},{"id":159,"json_url":"https://www.federalregister.gov/api/v1/agencies/159","name":"Federal Aviation Administration","parent_id":492,"raw_name":"Federal Aviation Administration","slug":"federal-aviation-administration","url":"https://www.federalregister.gov/agencies/federal-aviation-administration"}],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2022/04/01/2022-06838.html","cfr_references":[],"citation":"87 FR 19168","comment_url":null,"comments_close_on":"2022-04-21","correction_of":null,"corrections":[],"dates":"Comments on this petition must identify the petition docket number and must be received on or before April 21, 2022.","disposition_notes":null,"docket_ids":["Docket No.: FAA-2021-1044","Summary Notice No. 2022-19"],"dockets":[{"agency_name":"FAA","documents":[{"allow_late_comments":null,"comment_count":2,"comment_end_date":"2022-04-22","comment_start_date":"2022-04-01","comment_url":"https://www.regulations.gov/commenton/FAA-2021-1044-0006","id":"FAA-2021-1044-0006","regulations_dot_gov_open_for_comment":false,"updated_at":"2023-02-28T12:21:09.526-05:00"}],"id":"FAA-2021-1044","supporting_documents":[],"supporting_documents_count":0,"title":"Central Plains Agronomy, LLC. - Exemption/Rulemaking"}],"docu